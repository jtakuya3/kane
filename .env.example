# Copy to .env and fill in your secrets.

# === Required ===

# Your OpenAI API key. Server-side only — never exposed to the browser.
OPENAI_API_KEY=sk-...

# Shared password the browser must enter to use this instance.
# Make this long and random. Example: openssl rand -hex 24
KANE_ACCESS_TOKEN=change-me-please

# === Required when deploying with docker compose + Caddy ===

# Public hostname pointing at this VPS. Free options:
#   1) DuckDNS:  e.g. kane-yours.duckdns.org
#   2) sslip.io: e.g. 203-0-113-9.sslip.io  (replace dots with dashes in the IP)
KANE_HOST=kane-yours.duckdns.org

# Contact e-mail used for Let's Encrypt certificate notifications.
LETSENCRYPT_EMAIL=you@example.com

# === Optional ===

# Override the realtime model. Defaults to gpt-realtime-2.
# OPENAI_REALTIME_MODEL=gpt-realtime-2

# Default voice. One of marin, cedar, alloy, ash, ballad, coral,
# echo, sage, shimmer, verse.
# OPENAI_REALTIME_VOICE=marin

# Bind address (only used when running outside Docker).
# HOST=0.0.0.0
# PORT=8000
