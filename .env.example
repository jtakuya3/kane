# Copy to .env and fill in your secrets.

# Required: your OpenAI API key (server-side only).
OPENAI_API_KEY=sk-...

# Optional: override the realtime model. Defaults to gpt-realtime-2.
# OPENAI_REALTIME_MODEL=gpt-realtime-2

# Optional: default voice. One of marin, cedar, alloy, ash, ballad, coral,
# echo, sage, shimmer, verse.
# OPENAI_REALTIME_VOICE=marin

# Optional: bind address.
# HOST=0.0.0.0
# PORT=8000
