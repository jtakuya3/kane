# ===========================================
# 5 Investor Agents — Environment Variables
# ===========================================
# Copy to .env and fill in your keys.
# Sources without keys will be skipped gracefully.

# ---- Required ----
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ---- X (Twitter) Posting ----
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ---- Optional: Enhances data quality ----
FRED_API_KEY=              # https://fred.stlouisfed.org/docs/api/api_key.html (free)
WHALE_ALERT_API_KEY=       # https://whale-alert.io/ (free tier)

# ---- Future Sources (add as needed) ----
# OPENSKY_CLIENT_ID=       # OpenSky Network
# OPENSKY_CLIENT_SECRET=
# AIS_API_KEY=             # aisstream.io
# FINNHUB_API_KEY=         # finnhub.io
# NEWSAPI_KEY=             # newsapi.org
